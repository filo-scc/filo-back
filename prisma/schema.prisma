generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Cargo {
  ADMIN
  PROPRIETARIO
  GERENTE
}

enum FormaPagamento {
  PIX
  TED
}

enum TipoCor{
  COR
  ESTAMPA
}

model Fabrico {
  id Int @id @default(autoincrement())

  foto_de_perfil String?
  cnpj String? @unique @db.VarChar(14)
  razao_social String?
  nome_fantasia String?
  ativo Boolean @default(true)
  fabricacao_sob_demanda Boolean @default(false)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  usuarios        Usuario[]
  clientes        Cliente[]
  parceiros       Parceiro[]
  etapas          Etapa[]
  produtos        Produto[]
  tipos_produto TipoProduto[]
  fichas_tecnicas FichaTecnica[]
  cores Cor[]
  fabrico_grades FabricoGrade[]
  tecidos Tecido[]
  aviamentos Aviamento[]
  pedidos Pedido[]

  @@map("fabricos")
}

model Usuario {
  id Int @id @default(autoincrement())

  email              String  @unique
  nome               String?
  senha              String
  foto_de_perfil     String?
  cargo              Cargo   @default(GERENTE)
  refresh_token_hash String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  fabrico_id Int?
  fabrico    Fabrico? @relation(fields: [fabrico_id], references: [id])

  endereco Endereco?

  @@map("usuarios")
}

model Parceiro {
  id Int @id @default(autoincrement())

  nome        String
  responsavel String?
  telefone    String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  forma_pagamento FormaPagamento?
  chave_pix       String?
  banco           String?
  agencia         String?
  conta           String?
  categoria       String?

  fabrico_id Int
  fabrico    Fabrico @relation(fields: [fabrico_id], references: [id])

  endereco Endereco?

  parceiro_produto parceiroProduto[]

  ficha_parceiro FichaParceiro[]

  @@unique([fabrico_id, nome])
  @@map("parceiros")
}

model Cliente {
  id Int @id @default(autoincrement())

  nome        String
  cnpj        String? @unique
  telefone    String?
  responsavel String?
  status      Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  cliente_produto ClienteProduto[]
  pedidos Pedido[]

  fabrico_id Int
  fabrico    Fabrico @relation(fields: [fabrico_id], references: [id])

  endereco Endereco?

  @@unique([fabrico_id, nome])
  @@map("clientes")
}

model Etapa {
  id Int @id @default(autoincrement())

  nome      String
  descricao String?
  ordem     Int
  ativa     Boolean @default(true)
  icone_id  Int?
  icone_verde_id Int?
  icone_cinza_id Int?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  fabrico_id Int
  fabrico    Fabrico @relation(fields: [fabrico_id], references: [id])
  icone      Icone?  @relation("EtapaIconePadrao", fields: [icone_id], references: [id])
  icone_verde Icone? @relation("EtapaIconeVerde", fields: [icone_verde_id], references: [id])
  icone_cinza Icone? @relation("EtapaIconeCinza", fields: [icone_cinza_id], references: [id])

  fichas_tecnicas FichaTecnica[]
  fichas_etapas   FichaEtapa[]

  @@unique([fabrico_id, nome])
  @@map("etapas")
}

model Endereco {
  id Int @id @default(autoincrement())

  rua         String?
  numero      String?
  bairro      String?
  complemento String?
  cidade      String?
  estado      String?
  cep         String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  usuario_id Int?     @unique
  usuario    Usuario? @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  parceiro_id Int?      @unique
  parceiro    Parceiro? @relation(fields: [parceiro_id], references: [id], onDelete: Cascade)

  cliente_id Int?     @unique
  cliente    Cliente? @relation(fields: [cliente_id], references: [id], onDelete: Cascade)

  @@map("enderecos")
}

model Produto {
  id Int @id @default(autoincrement())

  foto String?
  nome String
  tipo_produto_id Int
  tipo_produto TipoProduto @relation(fields: [tipo_produto_id], references: [id])

  cliente_produto ClienteProduto[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  fabrico_id Int
  fabrico    Fabrico @relation(fields: [fabrico_id], references: [id])

  grade_versao_id Int?
  grade_versao    GradeVersao? @relation(fields: [grade_versao_id], references: [id])

  tecido_id Int?
  tecido Tecido? @relation(fields: [tecido_id], references: [id])

  produtoAviamentos ProdutoAviamento[]

  fichas_tecnicas  FichaTecnica[]
  parceiro_produto parceiroProduto[]

  @@unique([fabrico_id, nome])
  @@index([fabrico_id])
  @@index([grade_versao_id])
  @@map("produtos")
}

model ProdutoAviamento {
  id Int @id @default(autoincrement())
  custo Decimal? @db.Decimal(10, 2)

  produto_id Int
  produto Produto @relation(fields: [produto_id], references: [id], onDelete: Cascade)

  aviamento_id Int
  aviamento Aviamento @relation(fields: [aviamento_id], references: [id], onDelete: Cascade)

  @@unique([produto_id, aviamento_id])
  @@map("produtos_aviamentos")
}

model Icone {
  id   Int     @id @default(autoincrement())
  link String?

  etapas Etapa[] @relation("EtapaIconePadrao")
  etapas_icone_verde Etapa[] @relation("EtapaIconeVerde")
  etapas_icone_cinza Etapa[] @relation("EtapaIconeCinza")
  
  @@map("icones")
}

model FichaTecnica {
  id Int @id @default(autoincrement())

  observacoes String?
  concluida Boolean
  quantidade Int @default(0)

  fabrico_id Int
  fabrico    Fabrico @relation(fields: [fabrico_id], references: [id], onDelete: Cascade)

  produto_id Int
  produto    Produto @relation(fields: [produto_id], references: [id], onDelete: Cascade)

  grade_versao_id Int
  grade_versao    GradeVersao @relation(fields: [grade_versao_id], references: [id])

  etapa_atual_id Int?
  etapa_atual Etapa? @relation(fields: [etapa_atual_id], references: [id])

  pedido_id Int?
  pedido Pedido? @relation(fields: [pedido_id], references: [id])

  fichas_etapas       FichaEtapa[]
  ficha_tecnica_itens FichaTecnicaItem[]

  ficha_parceiro FichaParceiro[]

  @@map("fichas-tecnicas")
}

model FichaParceiro {
  operacao String?
  valor Decimal?
  quantidade Int?
  
  ficha_id Int
  ficha    FichaTecnica @relation(fields: [ficha_id], references: [id], onDelete: Cascade)

  parceiro_id Int
  parceiro    Parceiro @relation(fields: [parceiro_id], references: [id], onDelete: Cascade)

  @@id([ficha_id, parceiro_id])
  @@map("ficha_tecnica_parceiro")
}

model ClienteProduto {
  nome_para_cliente String
  preco_padrao      Float  @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  produto_id Int
  produto    Produto @relation(fields: [produto_id], references: [id], onDelete: Cascade)

  cliente_id Int
  cliente    Cliente @relation(fields: [cliente_id], references: [id], onDelete: Cascade)

  @@id([produto_id, cliente_id])
  @@map("cliente_produto")
}

model parceiroProduto {
  produto_id  Int
  parceiro_id Int

  produto  Produto  @relation(fields: [produto_id], references: [id], onDelete: Cascade)
  parceiro Parceiro @relation(fields: [parceiro_id], references: [id], onDelete: Cascade)

  preco Float

  @@id([produto_id, parceiro_id])
  @@map("parceiro_produto")
}

model FichaEtapa {
  id Int @id @default(autoincrement())

  data_inicio DateTime?
  data_fim    DateTime?
  observacoes String?

  ficha_tecnica_id Int
  ficha_tecnica    FichaTecnica @relation(fields: [ficha_tecnica_id], references: [id])

  etapa_id Int
  etapa    Etapa @relation(fields: [etapa_id], references: [id])

  @@unique([ficha_tecnica_id, etapa_id])
  @@map("fichas-etapas")
}

model Tamanho {
  id Int @id @default(autoincrement())

  codigo       String @unique
  ordem_global Int    @unique

  grade_items        GradeItem[]
  grade_versao_items GradeVersaoItem[]

  @@map("tamanhos")
}

model Grade {
  id Int @id @default(autoincrement())

  nome  String  @unique
  ativo Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  items          GradeItem[]
  versoes        GradeVersao[]
  fabrico_grades FabricoGrade[]

  @@map("grades")
}

model GradeItem {
  id Int @id @default(autoincrement())

  grade_id   Int
  tamanho_id Int
  posicao    Int

  grade   Grade   @relation(fields: [grade_id], references: [id], onDelete: Cascade)
  tamanho Tamanho @relation(fields: [tamanho_id], references: [id], onDelete: Restrict)

  @@unique([grade_id, tamanho_id])
  @@unique([grade_id, posicao])
  @@index([grade_id])
  @@index([tamanho_id])
  @@map("grade_itens")
}

model GradeVersao {
  id Int @id @default(autoincrement())

  grade_id Int
  versao   Int
  ativo    Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  grade           Grade             @relation(fields: [grade_id], references: [id], onDelete: Cascade)
  itens           GradeVersaoItem[]
  produtos        Produto[]
  fichas_tecnicas FichaTecnica[]

  @@unique([grade_id, versao])
  @@index([grade_id])
  @@map("grade_versoes")
}

model GradeVersaoItem {
  id Int @id @default(autoincrement())

  grade_versao_id Int
  tamanho_id      Int
  posicao         Int

  grade_versao GradeVersao @relation(fields: [grade_versao_id], references: [id], onDelete: Cascade)
  tamanho      Tamanho     @relation(fields: [tamanho_id], references: [id], onDelete: Restrict)

  ficha_tecnica_itens FichaTecnicaItem[]

  @@unique([grade_versao_id, tamanho_id])
  @@unique([grade_versao_id, posicao])
  @@index([grade_versao_id])
  @@index([tamanho_id])
  @@map("grade_versao_itens")
}

model FabricoGrade {
  id Int @id @default(autoincrement())

  fabrico_id Int
  grade_id   Int
  ativo      Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  fabrico Fabrico @relation(fields: [fabrico_id], references: [id], onDelete: Cascade)
  grade   Grade   @relation(fields: [grade_id], references: [id], onDelete: Restrict)

  @@unique([fabrico_id, grade_id])
  @@index([fabrico_id])
  @@index([grade_id])
  @@map("fabrico_grades")
}

model Cor {
  id Int @id @default(autoincrement())

  fabrico_id Int
  nome       String
  codigo_hex String?

  tipo TipoCor
  foto String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  fabrico Fabrico @relation(fields: [fabrico_id], references: [id], onDelete: Cascade)

  ficha_tecnica_itens FichaTecnicaItem[]

  @@unique([fabrico_id, nome])
  @@index([fabrico_id])
  @@map("cores")
}

model FichaTecnicaItem {
  id Int @id @default(autoincrement())

  ficha_tecnica_id Int
  ficha_tecnica    FichaTecnica @relation(fields: [ficha_tecnica_id], references: [id], onDelete: Cascade)

  cor_id Int
  cor    Cor @relation(fields: [cor_id], references: [id], onDelete: Restrict)

  grade_versao_item_id Int
  grade_versao_item    GradeVersaoItem @relation(fields: [grade_versao_item_id], references: [id], onDelete: Restrict)

  quantidade Int @default(0)

  @@unique([ficha_tecnica_id, cor_id, grade_versao_item_id])
  @@index([ficha_tecnica_id])
  @@index([cor_id])
  @@index([grade_versao_item_id])
  @@map("ficha_tecnica_itens")
}

model Tecido {
  id Int @id @default(autoincrement())

  nome String

  fabrico_id Int
  fabrico    Fabrico @relation(fields: [fabrico_id], references: [id], onDelete: Cascade)

  tecido_produto Produto[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([fabrico_id, nome])
  @@index([fabrico_id])
  @@map("tecidos")
}

model Aviamento {
  id Int @id @default(autoincrement())

  nome       String
  fabrico_id Int

  fabrico Fabrico @relation(fields: [fabrico_id], references: [id])

  produtoAviamentos ProdutoAviamento[]

  @@unique([nome, fabrico_id])
  @@map("aviamentos")
}

model Pedido {
  id Int @id @default(autoincrement())

  finalizado Boolean
  data_prevista DateTime?
  observacoes String?
  cliente_id Int?
  fabrico_id Int
  numero Int?
  cor String
  quantidade Int @default(0)
  valor_total Float?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  cliente Cliente? @relation(fields: [cliente_id], references: [id])
  fabrico Fabrico @relation(fields: [fabrico_id], references: [id])

  fichas_tecnicas FichaTecnica[]

  @@unique([fabrico_id, numero])
  @@map("pedidos")
}

model TipoProduto {
  id Int @id @default(autoincrement())

  nome String

  fabrico_id Int
  fabrico Fabrico @relation(fields: [fabrico_id], references: [id])

  produtos Produto[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([fabrico_id, nome])
  @@index([fabrico_id])

  @@map("tipo_produto")
}