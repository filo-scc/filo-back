generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Fabrico {
  id             Int       @id @default(autoincrement())
  foto_de_perfil String?
  cnpj           String?   @unique @db.VarChar(14)
  razao_social   String?
  nome_fantasia  String?
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  ativo          Boolean   @default(true)
  faccoes        Faccao[]
  usuarios       Usuario[]

  @@map("fabricos")
}

model Usuario {
  id         Int      @id @default(autoincrement())
  email      String?  @unique
  nome       String?
  senha      String?
  fabrico_id Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  cargo      Cargo    @default(GERENTE)
  fabrico    Fabrico  @relation(fields: [fabrico_id], references: [id])

  @@map("usuarios")
}

model Faccao {
  id         Int     @id @default(autoincrement())
  nome       String
  telefone   String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  fabrico_id Int
  fabrico    Fabrico @relation(fields: [fabrico_id], references: [id])

  @@map("faccoes")
}

enum Cargo {
  ADMIN
  DONO
  GERENTE
}
