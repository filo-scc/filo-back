generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Cargo {
  ADMIN
  DONO
  GERENTE
}

model Fabrico {
  id Int @id @default(autoincrement())

  foto_de_perfil String?
  cnpj String? @unique @db.VarChar(14)
  razao_social String?
  nome_fantasia String?
  ativo Boolean @default(true)

  usuarios Usuario[]
  clientes Cliente[]
  faccoes Faccao[]
  
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("fabricos")
}

model Usuario {
  id Int @id @default(autoincrement())

  email String? @unique
  nome String?
  senha String?
  foto_de_perfil String?
  cargo Cargo @default(GERENTE)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  fabrico_id Int?
  fabrico Fabrico? @relation(fields: [fabrico_id], references: [id])

  @@map("usuarios")
}

model Faccao {
  id         Int     @id @default(autoincrement())
  nome       String
  telefone   String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  fabrico_id Int
  fabrico    Fabrico @relation(fields: [fabrico_id], references: [id])

  @@map("faccoes")
}

model Cliente {
  id Int @id @default(autoincrement())

  nome String
  cnpj String? @unique
  telefone String?
  responsavel String?
  status Boolean @default(true)
  
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  fabrico_id Int
  fabrico Fabrico @relation(fields: [fabrico_id], references: [id])

  @@map("clientes")
}
