generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Cargo {
  ADMIN
  PROPRIETARIO
  GERENTE
}

enum FormaPagamento {
  PIX
  TED
}

model Fabrico {
  id Int @id @default(autoincrement())

  foto_de_perfil String?
  cnpj String? @unique @db.VarChar(14)
  razao_social String?
  nome_fantasia String?
  ativo Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  usuarios Usuario[]
  clientes Cliente[]
  faccoes Faccao[]
  etapas Etapa[]
  produtos Produto[]
  fichas_tecnicas FichaTecnica[]
  cores Cor[]
  fabrico_grades FabricoGrade[]

  @@map("fabricos")
}

model Usuario {
  id Int @id @default(autoincrement())

  email String @unique
  nome String?
  senha String
  foto_de_perfil String?
  cargo Cargo @default(GERENTE)
  refresh_token_hash String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  fabrico_id Int?
  fabrico Fabrico? @relation(fields: [fabrico_id], references: [id])

  endereco Endereco?

  @@map("usuarios")
}

model Faccao {
  id Int @id @default(autoincrement())

  nome String
  responsavel String?
  telefone String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  forma_pagamento FormaPagamento?
  chave_pix String?
  banco String?
  agencia String?
  conta String?

  fabrico_id Int
  fabrico Fabrico @relation(fields: [fabrico_id], references: [id])

  endereco Endereco?

  faccao_produto FaccaoProduto[]

  @@unique([fabrico_id, nome])
  @@map("faccoes")
}

model Cliente {
  id Int @id @default(autoincrement())

  nome String
  cnpj String? @unique
  telefone String?
  responsavel String?
  status Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  cliente_produto ClienteProduto[]

  fabrico_id Int
  fabrico Fabrico @relation(fields: [fabrico_id], references: [id])

  endereco Endereco?

  @@unique([fabrico_id, nome])
  @@map("clientes")
}

model Etapa {
  id Int @id @default(autoincrement())

  nome String
  descricao String?
  ordem Int
  ativa Boolean @default(true)
  icone_id Int?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  fabrico_id Int
  fabrico Fabrico @relation(fields: [fabrico_id], references: [id])
  icone Icone? @relation(fields: [icone_id], references: [id])

  fichas_tecnicas FichaTecnica[]
  fichas_etapas FichaEtapa[]

  @@unique([fabrico_id, nome])
  @@map("etapas")
}

model Endereco {
  id Int @id @default(autoincrement())

  rua String?
  numero String?
  bairro String?
  complemento String?
  cidade String?
  estado String?
  cep String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  usuario_id Int? @unique
  usuario Usuario? @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  faccao_id Int? @unique
  faccao Faccao? @relation(fields: [faccao_id], references: [id], onDelete: Cascade)

  cliente_id Int? @unique
  cliente Cliente? @relation(fields: [cliente_id], references: [id], onDelete: Cascade)

  @@map("enderecos")
}

model Produto {
  id Int @id @default(autoincrement())

  foto String?
  nome String
  tipo String

  cliente_produto ClienteProduto[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  fabrico_id Int
  fabrico Fabrico @relation(fields: [fabrico_id], references: [id])

  grade_versao_id Int?
  grade_versao GradeVersao? @relation(fields: [grade_versao_id], references: [id])

  fichas_tecnicas FichaTecnica[]
  faccao_produto FaccaoProduto[]

  @@unique([fabrico_id, nome])
  @@index([fabrico_id])
  @@index([grade_versao_id])
  @@map("produtos")
}

model Icone {
  id Int @id @default(autoincrement())
  link String?

  etapas Etapa[]

  @@map("icones")
}

model FichaTecnica {
  id Int @id @default(autoincrement())

  observacoes String?
  concluida Boolean

  fabrico_id Int
  fabrico Fabrico @relation(fields: [fabrico_id], references: [id], onDelete: Cascade)

  produto_id Int
  produto Produto @relation(fields: [produto_id], references: [id], onDelete: Cascade)

  grade_versao_id Int
  grade_versao GradeVersao @relation(fields: [grade_versao_id], references: [id])

  etapa_atual_id Int?
  etapa_atual Etapa? @relation(fields: [etapa_atual_id], references: [id])

  fichas_etapas FichaEtapa[]
  ficha_tecnica_itens FichaTecnicaItem[]

  @@map("fichas-tecnicas")
}

model ClienteProduto {
  nome_para_cliente String
  preco_padrao Float @default(0)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  produto_id Int
  produto Produto @relation(fields: [produto_id], references: [id], onDelete: Cascade)

  cliente_id Int
  cliente Cliente @relation(fields: [cliente_id], references: [id], onDelete: Cascade)

  @@id([produto_id, cliente_id])
  @@map("cliente_produto")
}

model FaccaoProduto {
  produto_id Int
  faccao_id Int

  produto Produto @relation(fields: [produto_id], references: [id], onDelete: Cascade)
  faccao Faccao @relation(fields: [faccao_id], references: [id], onDelete: Cascade)

  preco Float

  @@id([produto_id, faccao_id])
  @@map("faccao_produto")
}

model FichaEtapa {
  id Int @id @default(autoincrement())

  data_inicio DateTime?
  data_fim DateTime?
  observacoes String?

  ficha_tecnica_id Int
  ficha_tecnica FichaTecnica @relation(fields: [ficha_tecnica_id], references: [id])

  etapa_id Int
  etapa Etapa @relation(fields: [etapa_id], references: [id])

  @@unique([ficha_tecnica_id, etapa_id])
  @@map("fichas-etapas")
}

model Tamanho {
  id Int @id @default(autoincrement())

  codigo String @unique
  ordem_global Int @unique

  grade_items GradeItem[]
  grade_versao_items GradeVersaoItem[]

  @@map("tamanhos")
}

model Grade {
  id Int @id @default(autoincrement())

  nome String @unique
  ativo Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  items GradeItem[]
  versoes GradeVersao[]
  fabrico_grades FabricoGrade[]

  @@map("grades")
}

model GradeItem {
  id Int @id @default(autoincrement())

  grade_id Int
  tamanho_id Int
  posicao Int

  grade Grade @relation(fields: [grade_id], references: [id], onDelete: Cascade)
  tamanho Tamanho @relation(fields: [tamanho_id], references: [id], onDelete: Restrict)

  @@unique([grade_id, tamanho_id])
  @@unique([grade_id, posicao])
  @@index([grade_id])
  @@index([tamanho_id])
  @@map("grade_itens")
}

model GradeVersao {
  id Int @id @default(autoincrement())

  grade_id Int
  versao Int
  ativo Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  grade Grade @relation(fields: [grade_id], references: [id], onDelete: Cascade)
  itens GradeVersaoItem[]
  produtos Produto[]
  fichas_tecnicas FichaTecnica[]

  @@unique([grade_id, versao])
  @@index([grade_id])
  @@map("grade_versoes")
}

model GradeVersaoItem {
  id Int @id @default(autoincrement())

  grade_versao_id Int
  tamanho_id Int
  posicao Int

  grade_versao GradeVersao @relation(fields: [grade_versao_id], references: [id], onDelete: Cascade)
  tamanho Tamanho @relation(fields: [tamanho_id], references: [id], onDelete: Restrict)

  ficha_tecnica_itens FichaTecnicaItem[]

  @@unique([grade_versao_id, tamanho_id])
  @@unique([grade_versao_id, posicao])
  @@index([grade_versao_id])
  @@index([tamanho_id])
  @@map("grade_versao_itens")
}

model FabricoGrade {
  id Int @id @default(autoincrement())

  fabrico_id Int
  grade_id Int
  ativo Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  fabrico Fabrico @relation(fields: [fabrico_id], references: [id], onDelete: Cascade)
  grade Grade @relation(fields: [grade_id], references: [id], onDelete: Restrict)

  @@unique([fabrico_id, grade_id])
  @@index([fabrico_id])
  @@index([grade_id])
  @@map("fabrico_grades")
}

model Cor {
  id Int @id @default(autoincrement())

  fabrico_id Int
  nome String
  codigo_hex String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  fabrico Fabrico @relation(fields: [fabrico_id], references: [id], onDelete: Cascade)

  ficha_tecnica_itens FichaTecnicaItem[]

  @@unique([fabrico_id, nome])
  @@index([fabrico_id])
  @@map("cores")
}

model FichaTecnicaItem {
  id Int @id @default(autoincrement())

  ficha_tecnica_id Int
  ficha_tecnica FichaTecnica @relation(fields: [ficha_tecnica_id], references: [id], onDelete: Cascade)

  cor_id Int
  cor Cor @relation(fields: [cor_id], references: [id], onDelete: Restrict)

  grade_versao_item_id Int
  grade_versao_item GradeVersaoItem @relation(fields: [grade_versao_item_id], references: [id], onDelete: Restrict)

  quantidade Int @default(0)

  @@unique([ficha_tecnica_id, cor_id, grade_versao_item_id])
  @@index([ficha_tecnica_id])
  @@index([cor_id])
  @@index([grade_versao_item_id])
  @@map("ficha_tecnica_itens")
}