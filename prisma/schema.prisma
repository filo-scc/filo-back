generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Cargo {
  ADMIN
  DONO
  GERENTE
}

model Cliente {
  id Int @id @default(autoincrement())

  nome String?
  cnpj String? @unique
  telefone String?
  responsavel String?
  status Boolean @default(false)
  

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  fabrico_id Int
  fabrico Fabrico @relation(fields: [fabrico_id], references: [id])

  @@map("clientes")
}

model Fabrico {
  id Int @id @default(autoincrement())

  foto_de_perfil String?
  cnpj String? @unique @db.VarChar(14)
  razao_social String?
  nome_fantasia String?
  ativo Boolean @default(true)

  usuarios Usuario[]
  clientes Cliente[]
  
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("fabricos")
}

model Usuario {
  id Int @id @default(autoincrement())

  email String? @unique
  nome String?
  senha String?
  cargo Cargo @default(GERENTE)

  fabrico_id Int
  fabrico Fabrico @relation(fields: [fabrico_id], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("usuarios")
}
