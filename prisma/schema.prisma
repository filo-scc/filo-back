generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Cargo {
  ADMIN
  DONO
  MEMBRO
}

model Fabrico {
  id Int @id @default(autoincrement())

  foto_de_perfil String?
  cnpj String? @unique @db.VarChar(14)
  razao_social String?
  nome_fantasia String?
  ativo Boolean @default(true)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  usuarios Usuario[]
  clientes Cliente[]
  faccoes Faccao[]
  etapas Etapa[]
  produtos Produto[]

  @@map("fabricos")
}

model Usuario {
  id Int @id @default(autoincrement())

  email String @unique
  nome String?
  senha String
  foto_de_perfil String?
  cargo Cargo @default(MEMBRO)
  refresh_token_hash String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  fabrico_id Int?
  fabrico Fabrico? @relation(fields: [fabrico_id], references: [id])

  endereco   Endereco?

  @@map("usuarios")
}


model Faccao {
  id Int @id @default(autoincrement())

  nome String
  telefone String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  fabrico_id Int
  fabrico Fabrico @relation(fields: [fabrico_id], references: [id])

  endereco Endereco?

  @@unique([fabrico_id, nome])
  @@map("faccoes")
}

model Cliente {
  id Int @id @default(autoincrement())

  nome String
  cnpj String? @unique
  telefone String?
  responsavel String?
  status Boolean @default(true)
  

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  cliente_produto ClienteProduto[]

  fabrico_id Int
  fabrico Fabrico @relation(fields: [fabrico_id], references: [id])

  @@unique([fabrico_id, nome])
  @@map("clientes")
}

model Etapa {
  id          Int     @id @default(autoincrement())

  fabrico_id  Int
  nome        String  
  descricao   String? 
  ordem       Int
  ativa       Boolean @default(true)

  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  fabrico Fabrico @relation(fields: [fabrico_id], references: [id])

  @@unique([fabrico_id, nome])
  @@map("etapas")
}

model Endereco {
  id Int @id @default(autoincrement())

  rua String?
  numero String?
  bairro String?
  complemento String?
  cidade String?
  estado String?

  created_at DateTime @default(now())
  updated_at  DateTime @updatedAt
  
  usuario_id  Int?     @unique 
  usuario     Usuario? @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  faccao_id   Int?     @unique 
  faccao      Faccao?  @relation(fields: [faccao_id], references: [id], onDelete: Cascade)

  @@map("enderecos")
}

model Produto {
  id   Int     @id @default(autoincrement())

  foto String?
  nome String
  tipo String

  cliente_produto ClienteProduto[]

  fabrico_id Int
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  fabrico Fabrico @relation(fields: [fabrico_id], references: [id])

  @@unique([fabrico_id, nome])
  @@map("produtos")
}

model ClienteProduto{

  nome_para_cliente String 
  preco_padrao Float @default(0)
  
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  produto_id Int
  produto Produto @relation(fields: [produto_id], references: [id], onDelete: Cascade) 

  cliente_id Int
  cliente Cliente @relation(fields: [cliente_id], references: [id], onDelete: Cascade) 

  @@id([produto_id, cliente_id])
  @@map("cliente_produto")
}
