# =============================================================================
# .env.example — Copie para .env e preencha os valores reais
# Nunca commite o .env — apenas este .env.example vai para o git
# =============================================================================

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_USER=filo
POSTGRES_PASSWORD=troque_por_senha_forte
POSTGRES_DB=filo_db

# HOST deve ser "db" (nome do serviço no compose) — NÃO "localhost"
# localhost funciona apenas quando rodando fora do Docker
# Em produção com Supabase + Render:
# DATABASE_URL           = transaction pooler (porta 6543, com ?pgbouncer=true) para runtime
# MIGRATION_DATABASE_URL = session pooler (porta 5432) para migrations
DATABASE_URL="<supabase-transaction-pooler-url>"
MIGRATION_DATABASE_URL="<supabase-session-pooler-url>"

# Local (Docker Compose)
#DATABASE_URL="postgresql://filo:troque_por_senha_forte@localhost:5432/filo_db?schema=public"

# ── Servidor ───────────────────────────────────────────────────────────────────
PORT=3000
# Lista separada por vírgula. Em produção, defina com a URL real do frontend.
CORS_ORIGINS=http://localhost:5173

# ── JWT ────────────────────────────────────────────────────────────────────────
# Gere valores seguros com:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=troque_por_segredo_forte_access
JWT_REFRESH_SECRET=troque_por_segredo_forte_refresh
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ── Supabase ───────────────────────────────────────────────────────────────────
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=troque_por_uma_chave_valida

# ── Seed ───────────────────────────────────────────────────────────────────────
# "true"  → roda o seed no próximo `docker compose up`
# "false" → ignora o seed (padrão)
RUN_SEED=false
